// prisma/schema.prisma
// MediVault Database Schema — University of Zambia Clinic Patient Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
  ADMIN
  NEXT_OF_KIN
  PHARMACIST
  LAB_TECHNICIAN
}

enum VisitStatus {
  WAITING
  CHECKED_IN
  IN_CONSULTATION
  CHECKED_OUT
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

// Lab: ORDERED (doctor asked) -> COLLECTED (sample taken) -> COMPLETED (all results in)
enum LabOrderStatus {
  ORDERED
  COLLECTED
  COMPLETED
  CANCELLED
}

enum LabPriority {
  ROUTINE
  URGENT
}

// How a single result compares with its reference range
enum LabFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

// Appointment request: patient asks (REQUESTED) -> receptionist CONFIRMED / DECLINED, or patient CANCELLED
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

// ─── Inpatient admissions ───────────────────────────────────────────────────
// ADMITTED -> DISCHARGED or CANCELLED. Nothing ever goes back to ADMITTED.
enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum AdmissionPriority {
  EMERGENCY
  URGENT
  ROUTINE
}

enum AdmissionSource {
  WALK_IN
  APPOINTMENT
  REFERRAL
  TRANSFER_IN
  EMERGENCY
}

enum DischargeDisposition {
  HOME
  TRANSFERRED_OUT
  LEFT_AGAINST_ADVICE
  DECEASED
}

enum AdmissionNoteKind {
  PROGRESS
  WARD_ROUND
  PROCEDURE
  DIAGNOSIS_UPDATE
}

// ─── Models ────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  studentNumber String?  @unique
  passwordHash  String
  role          Role
  fullName      String
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  patientProfile       PatientProfile?
  recordsCreated       MedicalRecord[]       @relation("DoctorNotes")
  patientRecords       MedicalRecord[]       @relation("PatientRecords")
  visitsCreated        Visit[]               @relation("CreatedBy")
  patientVisits        Visit[]               @relation("PatientVisits")
  accessLogs           AccessLog[]           @relation("AccessedBy")
  accessLogsAbout      AccessLog[]           @relation("TargetPatient")
  kinAssignments       NextOfKinAssignment[] @relation("Patient")
  kinFor               NextOfKinAssignment[] @relation("NextOfKin")
  // Prescriptions created by this user (as doctor)
  prescriptionsIssued  Prescription[]        @relation("PrescriptionDoctor")
  // Prescriptions dispensed by this user (as pharmacist)
  prescriptionsFilled  Prescription[]        @relation("PrescriptionPharmacist")
  // Prescriptions belonging to this user (as patient)
  patientPrescriptions Prescription[]        @relation("PrescriptionPatient")
  // Drug inventory updates made by this user
  drugUpdates          DrugInventory[]       @relation("DrugUpdatedBy")
  // Lab orders: belonging to this user (as patient), and each step of the lab workflow
  labOrdersAsPatient   LabOrder[]            @relation("LabOrderPatient")
  labOrdersPlaced      LabOrder[]            @relation("LabOrderOrderedBy")
  labOrdersCollected   LabOrder[]            @relation("LabOrderCollectedBy")
  labOrdersCompleted   LabOrder[]            @relation("LabOrderCompletedBy")
  labOrdersReviewed    LabOrder[]            @relation("LabOrderReviewedBy")
  // Appointment requests: made by this user (as patient), and handled by this user (as receptionist)
  appointmentRequests  AppointmentRequest[]  @relation("AppointmentPatient")
  appointmentsHandled  AppointmentRequest[]  @relation("AppointmentHandledBy")
  // In-app notifications addressed to this user
  notifications        Notification[]
  // Secure messages: the patient side of a thread, the doctor side, and the ones this user wrote
  messagesAsPatient    Message[]             @relation("MessagePatient")
  messagesAsDoctor     Message[]             @relation("MessageDoctor")
  messagesSent         Message[]             @relation("MessageSender")
  // Admissions: as the patient, as admitting doctor, as attending doctor, and the discharge / cancel steps
  admissionsAsPatient    Admission[]         @relation("AdmissionPatient")
  admissionsAdmitted     Admission[]         @relation("AdmissionAdmittingDoctor")
  admissionsAttending    Admission[]         @relation("AdmissionAttendingDoctor")
  admissionsDischarged   Admission[]         @relation("AdmissionDischargedBy")
  admissionsCancelled    Admission[]         @relation("AdmissionCancelledBy")
  admissionNotesWritten  AdmissionNote[]     @relation("AdmissionNoteAuthor")
  vitalsRecorded         VitalsReading[]     @relation("VitalsRecordedBy")
}

model PatientProfile {
  userId                String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  bloodType             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
}

model MedicalRecord {
  id            String         @id @default(cuid())
  patientId     String
  patient       User           @relation("PatientRecords", fields: [patientId], references: [id])
  doctorId      String
  doctor        User           @relation("DoctorNotes", fields: [doctorId], references: [id])
  diagnosis     String
  medications   String?
  allergies     String?
  notes         String?
  visitDate     DateTime       @default(now())
  followUpDate  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Prescriptions linked to this record
  prescriptions Prescription[]
  // Set only when the record was written during an inpatient stay (null for normal clinic records)
  admissionId   String?
  admission     Admission?     @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
}

model Visit {
  id          String      @id @default(cuid())
  patientId   String
  patient     User        @relation("PatientVisits", fields: [patientId], references: [id])
  visitDate   DateTime    @default(now())
  reason      String
  vitals      String?
  doctorNotes String?
  status      VisitStatus @default(WAITING)
  createdById String
  createdBy   User        @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── Pharmacy Models (NEW) ──────────────────────────────────────────────────

model Prescription {
  id              String             @id @default(cuid())
  // The patient this prescription belongs to
  patientId       String
  patient         User               @relation("PrescriptionPatient", fields: [patientId], references: [id])
  // The doctor who issued it
  doctorId        String
  doctor          User               @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  // The pharmacist who dispensed it (null until dispensed)
  pharmacistId    String?
  pharmacist      User?              @relation("PrescriptionPharmacist", fields: [pharmacistId], references: [id])
  // The medical record this prescription is linked to
  medicalRecordId String?
  medicalRecord   MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  // Medications as JSON: [{"name":"...","dose":"...","duration":"...","quantity":10}]
  medications     String
  status          PrescriptionStatus @default(PENDING)
  dispensedAt     DateTime?
  notes           String?
  // Set only when prescribed during an inpatient stay
  admissionId     String?
  admission       Admission?         @relation(fields: [admissionId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([admissionId])
}

model DrugInventory {
  id           String    @id @default(cuid())
  drugName     String
  genericName  String?
  quantity     Int       @default(0)
  unit         String // e.g. "tablets", "ml", "capsules"
  expiryDate   DateTime?
  reorderLevel Int       @default(10)
  // The pharmacist/admin who last updated this entry
  updatedById  String?
  updatedBy    User?     @relation("DrugUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Existing Models ────────────────────────────────────────────────────────

model NextOfKinAssignment {
  id                    String    @id @default(cuid())
  patientId             String
  patient               User      @relation("Patient", fields: [patientId], references: [id])
  kinUserId             String
  nextOfKin             User      @relation("NextOfKin", fields: [kinUserId], references: [id])
  isActive              Boolean   @default(true)
  delegatedAt           DateTime  @default(now())
  emergencyConsentGiven Boolean   @default(false)
  consentGivenAt        DateTime?
  updatedAt             DateTime  @updatedAt
}

model AccessLog {
  id               String   @id @default(cuid())
  accessedByUserId String
  accessedBy       User     @relation("AccessedBy", fields: [accessedByUserId], references: [id])
  targetPatientId  String?
  targetPatient    User?    @relation("TargetPatient", fields: [targetPatientId], references: [id])
  action           String
  resourceType     String
  resourceId       String?
  details          String?
  ipAddress        String?
  userAgent        String?
  timestamp        DateTime @default(now())
}

// ─── Laboratory ────────────────────────────────────────────────────────────

// The list of tests the clinic lab can run, with their normal ranges.
model LabTest {
  id             String   @id @default(cuid())
  code           String   @unique // short code, e.g. "HB"
  name           String // e.g. "Haemoglobin"
  category       String // e.g. "Haematology"
  unit           String? // e.g. "g/dL" (numeric tests)
  refLow         Float? // normal range, low end
  refHigh        Float? // normal range, high end
  criticalLow    Float? // below this needs urgent action
  criticalHigh   Float? // above this needs urgent action
  normalText     String? // for yes/no style tests: the normal answer, e.g. "Negative"
  allowedResults String? // for those tests: comma-separated choices, e.g. "Negative,Positive"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems LabOrderItem[]
}

// A doctor's request for one or more tests for a patient.
model LabOrder {
  id            String         @id @default(cuid())
  patientId     String
  orderedById   String
  priority      LabPriority    @default(ROUTINE)
  status        LabOrderStatus @default(ORDERED)
  clinicalNotes String?
  collectedAt   DateTime?
  collectedById String?
  completedAt   DateTime?
  completedById String?
  // The patient only sees results after the ordering doctor has reviewed them
  reviewedAt    DateTime?
  reviewedById  String?
  doctorComment String?
  // Set only when ordered from an inpatient admission
  admissionId   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  admission   Admission?     @relation(fields: [admissionId], references: [id])
  patient     User           @relation("LabOrderPatient", fields: [patientId], references: [id])
  orderedBy   User           @relation("LabOrderOrderedBy", fields: [orderedById], references: [id])
  collectedBy User?          @relation("LabOrderCollectedBy", fields: [collectedById], references: [id])
  completedBy User?          @relation("LabOrderCompletedBy", fields: [completedById], references: [id])
  reviewedBy  User?          @relation("LabOrderReviewedBy", fields: [reviewedById], references: [id])
  items       LabOrderItem[]

  @@index([patientId])
  @@index([status])
  @@index([admissionId])
}

// One test inside an order, and (once the lab has run it) its result.
// The unit and ranges are COPIED from the test when the order is placed, so
// changing the catalogue later never rewrites the meaning of an old result.
model LabOrderItem {
  id           String    @id @default(cuid())
  orderId      String
  testId       String
  unit         String?
  refLow       Float?
  refHigh      Float?
  criticalLow  Float?
  criticalHigh Float?
  normalText   String?
  valueNumeric Float?
  valueText    String?
  flag         LabFlag?
  notes        String?
  resultAt     DateTime?

  order LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test  LabTest  @relation(fields: [testId], references: [id])

  @@unique([orderId, testId])
}

// ─── Patient engagement: appointments, notifications, messages ──────────────

// A patient asks for an appointment; a receptionist confirms (which creates a
// Visit on the confirmed date) or declines it with a note.
model AppointmentRequest {
  id            String            @id @default(cuid())
  patientId     String
  patient       User              @relation("AppointmentPatient", fields: [patientId], references: [id])
  // When the patient would like to come, and why
  preferredDate DateTime
  reason        String
  status        AppointmentStatus @default(REQUESTED)
  // Filled in when the receptionist answers
  handledById   String?
  handledBy     User?             @relation("AppointmentHandledBy", fields: [handledById], references: [id])
  handledAt     DateTime?
  scheduledFor  DateTime?
  responseNote  String?
  // The Visit created when the request was confirmed (plain id, no relation, so
  // a visit can be removed without breaking the request history)
  visitId       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([patientId])
  @@index([status])
}

// A short message shown in the bell menu: "your lab result is ready", etc.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Short machine-readable kind, e.g. "LAB_RESULT_READY" (used to pick an icon)
  type      String
  title     String
  body      String?
  // Where clicking the notification should take the user, e.g. "/dashboard/patient#labs"
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// One message in a private thread between ONE patient and ONE doctor.
// A thread is simply "all messages with this patientId + doctorId".
model Message {
  id        String    @id @default(cuid())
  patientId String
  patient   User      @relation("MessagePatient", fields: [patientId], references: [id])
  doctorId  String
  doctor    User      @relation("MessageDoctor", fields: [doctorId], references: [id])
  // Who wrote it: either the patient or the doctor of the thread
  senderId  String
  sender    User      @relation("MessageSender", fields: [senderId], references: [id])
  body      String
  // Set when the OTHER person opens the thread
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId, doctorId, createdAt])
}

// ─── Inpatient admissions ──────────────────────────────────────────────────

// One inpatient stay (or short-stay observation) under a doctor.
// A patient may have many admissions over time, but only ONE with status ADMITTED.
// The "only one ADMITTED" rule is enforced by a partial unique index that lives in the
// migration SQL (Prisma cannot express it): one_active_admission_per_patient.
model Admission {
  id              String            @id @default(cuid())
  // Human-friendly number such as ADM-2026-000123, made inside the creating transaction
  admissionNumber String            @unique
  patientId       String
  admittingDoctorId String
  attendingDoctorId String
  // The clinic visit this admission came from (plain id, no relation, like AppointmentRequest.visitId)
  visitId         String?

  // Reason and first assessment
  priority            AdmissionPriority
  source              AdmissionSource
  referralFrom        String?
  presentingComplaint String
  reason              String
  provisionalDiagnosis String?
  admissionNotes      String?
  examinationFindings String?
  // Free-text snapshots taken on admission
  knownAllergies      String?
  existingConditions  String?
  currentMedication   String?

  // Admission and consent. Stored in UTC; shown in Africa/Lusaka.
  admittedAt          DateTime          @default(now())
  expectedDischargeAt DateTime?
  // "PATIENT" or "NEXT_OF_KIN"
  consentBy           String
  // Required when consentBy is NEXT_OF_KIN (the assignment must be active with consent given)
  consentKinAssignmentId String?

  status          AdmissionStatus   @default(ADMITTED)

  // Cancellation
  cancelReason    String?
  cancelledAt     DateTime?
  cancelledById   String?

  // Discharge (all empty until the patient is discharged)
  dischargedAt         DateTime?
  dischargedById       String?
  dischargeDisposition DischargeDisposition?
  finalDiagnosis       String?
  dischargeSummary     String?
  dischargeInstructions String?
  followUpDate         DateTime?
  transferDestination  String?
  timeOfDeath          DateTime?
  causeOfDeath         String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient         User              @relation("AdmissionPatient", fields: [patientId], references: [id])
  admittingDoctor User              @relation("AdmissionAdmittingDoctor", fields: [admittingDoctorId], references: [id])
  attendingDoctor User              @relation("AdmissionAttendingDoctor", fields: [attendingDoctorId], references: [id])
  dischargedBy    User?             @relation("AdmissionDischargedBy", fields: [dischargedById], references: [id])
  cancelledBy     User?             @relation("AdmissionCancelledBy", fields: [cancelledById], references: [id])

  notes           AdmissionNote[]
  vitals          VitalsReading[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  medicalRecords  MedicalRecord[]

  @@index([patientId, admittedAt])
  @@index([status, admittedAt])
}

// A note written during the stay. Append-only: there is no edit or delete endpoint.
model AdmissionNote {
  id          String            @id @default(cuid())
  admissionId String
  authorId    String
  kind        AdmissionNoteKind
  body        String
  createdAt   DateTime          @default(now())

  admission   Admission         @relation(fields: [admissionId], references: [id])
  author      User              @relation("AdmissionNoteAuthor", fields: [authorId], references: [id])

  @@index([admissionId, createdAt])
}

// One set of observations. Separate from Visit.vitals (which is free text).
model VitalsReading {
  id           String    @id @default(cuid())
  admissionId  String
  // Every measurement is optional, because staff do not always take all of them
  temperature  Float?    // degrees Celsius
  pulse        Int?      // beats per minute
  systolic     Int?      // mmHg
  diastolic    Int?      // mmHg
  respRate     Int?      // breaths per minute
  spo2         Int?      // oxygen saturation, percent
  weightKg     Float?
  recordedAt   DateTime  @default(now())
  recordedById String

  admission    Admission @relation(fields: [admissionId], references: [id])
  recordedBy   User      @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  @@index([admissionId, recordedAt])
}

// One row per calendar year. Used to hand out admission numbers without two requests ever
// getting the same one: the row is incremented inside the same transaction that creates the admission.
model AdmissionCounter {
  year       Int @id
  lastNumber Int @default(0)
}

# =============================================================
# MediVault Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================

# ── Database ──────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local PostgreSQL:
DATABASE_URL="postgresql://postgres:pass1234@localhost:5432/mediavault"

# ── JWT Secret ───────────────────────────────────────────────
# Use a long random string (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ae2a15ff0de0327076803b8d9f2e9e21192871e648fcf2ecc053f194dbbafff488148330e39fd473bda4c6f8f6fc46845ef238538dab5f31a2b8a6872e8a22df"

# ── App Environment ───────────────────────────────────────────
# Set to "production" when deploying to a server
NODE_ENV="development"

# ── Logging ──────────────────────────────────────────────────
# Log levels: fatal, error, warn, info, debug, trace
LOG_LEVEL="info"

# ── Optional: Next.js ─────────────────────────────────────────
# Only needed if deploying behind a reverse proxy
# NEXTAUTH_URL="http://localhost:3000"
